# Copy to .env for production builds (Vercel / wrangler deploy).

# Sim API (backend)
# VITE_API_BASE=https://your-backend.fly.dev

# ML API (training + dispatch compare). Required in production for ML UI.
# VITE_ML_BASE=https://your-ml.fly.dev
VITE_ML_ENABLED=true

# Analytics (optional)
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
